@model MicrosoftPracticeManagement.Web.ViewModels.TimesheetsViewModel
@{
    ViewData["Title"] = "Timesheet Compliance Dashboard";
}

<!-- Page Header -->
<div class="page-header-bar">
    <div>
        <h1 class="page-title">Timesheet Compliance Dashboard</h1>
        <div class="page-desc">Delivery timesheet tracking, approval workflows, and billing audit compliance</div>
    </div>
    <div class="d-flex gap-2">
        <form method="get" class="d-flex align-items-center gap-2">
            <input type="month" name="month" value="@Model.SelectedMonth" class="form-control form-control-sm" onchange="this.form.submit()" />
        </form>
    </div>
</div>

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="kpi-card kpi-green">
            <div class="kpi-label"><span>Compliance Rate</span><i class="bi bi-shield-check text-success"></i></div>
            <div class="kpi-value">@Model.Compliance.ComplianceRatePercent%</div>
            <div class="kpi-trend trend-up"><i class="bi bi-arrow-up-short"></i><span>Target: > 95%</span></div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="kpi-card">
            <div class="kpi-label"><span>Total Submissions</span><i class="bi bi-file-earmark-check text-primary"></i></div>
            <div class="kpi-value">@Model.Compliance.TotalSubmissions</div>
            <div class="kpi-trend trend-neutral"><i class="bi bi-calendar3"></i><span>Period: @Model.SelectedMonth</span></div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="kpi-card kpi-amber">
            <div class="kpi-label"><span>Late Submissions</span><i class="bi bi-clock-history text-warning"></i></div>
            <div class="kpi-value">@Model.Compliance.LateSubmissionsCount</div>
            <div class="kpi-trend trend-down"><i class="bi bi-exclamation-circle"></i><span>Action required</span></div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="kpi-card kpi-purple">
            <div class="kpi-label"><span>Pending Approvals</span><i class="bi bi-hourglass text-purple"></i></div>
            <div class="kpi-value">@Model.Compliance.PendingApprovalsCount</div>
            <div class="kpi-trend trend-neutral"><i class="bi bi-person-check"></i><span>Manager review</span></div>
        </div>
    </div>
</div>

<!-- Timesheets List -->
<div class="fluent-table-wrapper">
    <div class="p-3 bg-light border-bottom d-flex justify-content-between align-items-center">
        <span class="fw-semibold text-dark" style="font-size: 13px;">Consultant Timesheet Entries (@Model.Compliance.RecentTimesheets.Count)</span>
    </div>
    <table class="fluent-table">
        <thead>
            <tr>
                <th>Consultant</th>
                <th>Project Engagement</th>
                <th>Hours Logged</th>
                <th>Status</th>
                <th>Submission Date</th>
                <th>Approver</th>
                <th class="text-end">Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in Model.Compliance.RecentTimesheets)
            {
                <tr>
                    <td>
                        <a asp-controller="Resources" asp-action="Details" asp-route-id="@t.EmployeeId" class="fw-semibold text-primary text-decoration-none">
                            @t.EmployeeName
                        </a>
                        <div class="text-muted" style="font-size: 11px;">@t.EmployeeId</div>
                    </td>
                    <td>@t.ProjectName</td>
                    <td>
                        <span class="fw-bold">@t.HoursLogged</span> / @t.ExpectedHours hrs
                    </td>
                    <td>
                        @if (t.Status == "Approved")
                        {
                            <span class="ms-badge badge-healthy">Approved</span>
                        }
                        else if (t.Status == "Submitted")
                        {
                            <span class="ms-badge badge-info">Submitted</span>
                        }
                        else if (t.Status == "Late")
                        {
                            <span class="ms-badge badge-attention">Late</span>
                        }
                        else
                        {
                            <span class="ms-badge badge-critical">Pending</span>
                        }
                    </td>
                    <td>@t.SubmissionDate.ToString("MMM dd, yyyy")</td>
                    <td>@t.ApproverName</td>
                    <td class="text-end">
                        @if (t.Status != "Approved")
                        {
                            <form asp-action="Approve" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="month" value="@t.YearMonth" />
                                <input type="hidden" name="employeeId" value="@t.EmployeeId" />
                                <button type="submit" class="btn btn-sm btn-outline-success py-0">Approve</button>
                            </form>
                        }
                        else
                        {
                            <span class="text-muted" style="font-size: 12px;"><i class="bi bi-check-all text-success"></i> Signed</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
