@section Scripts {
    <script>
        // Pass JSON chart payloads directly from ViewModel for instant rendering
        window.dashboardChartData = {
            utilizationDonut: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Summary.UtilizationDonutChart)),
            techDistribution: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Summary.TechnologyDistributionBarChart)),
            capacityVsDemand: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Summary.CapacityVsDemandChart)),
            utilizationTrend: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Summary.UtilizationTrendLineChart))
        };
    </script>
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
}
