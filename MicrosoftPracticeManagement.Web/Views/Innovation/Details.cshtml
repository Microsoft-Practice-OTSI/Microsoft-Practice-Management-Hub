@model MicrosoftPracticeManagement.Services.DTOs.InnovationDto
@{
    ViewData["Title"] = $"{Model.Title} - Solution Details";
}

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb" style="font-size: 13px;">
        <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Innovation & IP</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.Id</li>
    </ol>
</nav>

<div class="fluent-card mb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge @(Model.Category == "Accelerator" ? "bg-primary" : "bg-success")">@Model.Category</span>
                <span class="badge bg-light text-dark border">@Model.Id</span>
                <div class="text-warning small ms-2">
                    @for (int i = 0; i < Model.RatingStars; i++)
                    {
                        <i class="bi bi-star-fill"></i>
                    }
                    <span class="text-muted ms-1">(@Model.DownloadsCount downloads)</span>
                </div>
            </div>
            <h1 class="page-title fs-4">@Model.Title</h1>
            <div class="text-muted mt-1" style="font-size: 13px;">
                <span>Author: <strong>@Model.AuthorName</strong> (@Model.AuthorRole)</span> • 
                <span>Account: <strong>@Model.ClientAccount</strong></span> • 
                <span>Published: <strong>@Model.PublishedDate.ToString("MMMM yyyy")</strong></span>
            </div>
        </div>

        <div class="d-flex gap-2">
            <a href="@Model.SharePointLink" target="_blank" class="btn-fluent-secondary">
                <i class="bi bi-microsoft"></i>SharePoint
            </a>
            <a asp-action="Download" asp-route-category="@Model.Category" asp-route-id="@Model.Id" class="btn-fluent-primary">
                <i class="bi bi-file-earmark-arrow-down"></i>Download Artifact
            </a>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="fluent-card mb-4">
            <div class="fluent-card-header">
                <h2 class="fluent-card-title"><i class="bi bi-lightbulb-fill text-warning"></i>Solution Architecture & Implementation</h2>
            </div>

            <div class="mb-4">
                <h5 class="fw-bold text-danger fs-6"><i class="bi bi-exclamation-triangle me-1"></i>Business Problem</h5>
                <p class="text-muted" style="font-size: 14px; line-height: 1.6;">
                    @Model.BusinessProblem
                </p>
            </div>

            <div class="mb-4">
                <h5 class="fw-bold text-success fs-6"><i class="bi bi-check-circle me-1"></i>Architected Solution</h5>
                <p class="text-dark" style="font-size: 14px; line-height: 1.6;">
                    @Model.Solution
                </p>
            </div>

            <div class="p-3 bg-success-subtle rounded border border-success-subtle mb-3">
                <h5 class="fw-bold text-success fs-6 mb-1"><i class="bi bi-graph-up-arrow me-1"></i>Business Impact & ROI</h5>
                <p class="text-dark mb-0 fw-medium" style="font-size: 14px;">
                    @Model.BusinessValue
                </p>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="fluent-card mb-4">
            <div class="fluent-card-header">
                <h3 class="fluent-card-title"><i class="bi bi-tags-fill text-primary"></i>Technology Stack</h3>
            </div>
            <div class="d-flex flex-wrap gap-2 mb-3">
                @foreach (var tag in Model.TechnologyTags.Split(','))
                {
                    <span class="badge bg-light text-dark border p-2">@tag.Trim()</span>
                }
            </div>
        </div>

        <div class="fluent-card">
            <div class="fluent-card-header">
                <h3 class="fluent-card-title"><i class="bi bi-cloud-arrow-down-fill text-primary"></i>Asset Downloads</h3>
            </div>
            <p class="text-muted" style="font-size: 13px;">
                Whitepaper stored in Azure Blob Storage container <code>@(Model.Category == "Accelerator" ? "accelerators" : "case-studies")</code>.
            </p>
            <a asp-action="Download" asp-route-category="@Model.Category" asp-route-id="@Model.Id" class="btn btn-outline-dark w-100">
                <i class="bi bi-file-earmark-pdf me-2"></i>Download Asset Package
            </a>
        </div>
    </div>
</div>
