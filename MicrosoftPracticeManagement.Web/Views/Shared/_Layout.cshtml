@using MicrosoftPracticeManagement.Services.Interfaces
@inject IResourceService ResourceService
@inject IProjectService ProjectService
@{
    var resources = await ResourceService.GetAllResourcesAsync();
    var resourceCount = resources.Count();
    
    var projects = await ProjectService.GetAllProjectsAsync();
    var projectCount = projects.Count();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Microsoft Practice Hub</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <!-- Fluent 2 Enterprise Theme -->
    <link rel="stylesheet" href="~/css/fluent-theme.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="app-wrapper">
        <!-- Top Header Navigation -->
        <header class="fluent-header">
            <div class="brand-section">
                <a asp-controller="Dashboard" asp-action="Index" class="d-flex align-items-center text-decoration-none text-dark gap-2">
                    <div class="ms-logo-icon">
                        <div class="ms-logo-tile tile-red"></div>
                        <div class="ms-logo-tile tile-green"></div>
                        <div class="ms-logo-tile tile-blue"></div>
                        <div class="ms-logo-tile tile-yellow"></div>
                    </div>
                    <span class="app-title">Microsoft Practice Hub</span>
                </a>
                <span class="app-subtitle d-none d-md-inline">People • Projects • Skills • Delivery • Growth</span>
            </div>

            <div class="header-center d-none d-lg-block">
                <div class="global-search-container">
                    <i class="bi bi-search search-icon-pos"></i>
                    <input type="text" id="globalSearchInput" class="global-search-input" placeholder="Search consultants, projects, skills, certifications... (Press Ctrl + /)" />
                </div>
            </div>

            <div class="header-right">
                <div class="practice-picker d-none d-sm-block">
                    <select id="practiceSelector" class="form-select form-select-sm">
                        <option value="Azure & Cloud" selected>Microsoft Azure & Cloud Practice</option>
                        <option value="Data & AI">Data & Applied AI Practice</option>
                        <option value="Power Platform">Power Platform & Dynamics Practice</option>
                        <option value="Digital Workplace">Modern Workplace Practice</option>
                    </select>
                </div>

                <!-- Notifications Dropdown -->
                <div class="dropdown">
                    <button class="btn btn-sm btn-outline-secondary position-relative border-0" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Notifications">
                        <i class="bi bi-bell fs-6"></i>
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 9px;">
                            4
                        </span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 p-2" style="width: 320px; font-size: 13px;">
                        <li class="dropdown-header fw-bold text-dark px-2 py-1">Recent Practice Alerts</li>
                        <li><hr class="dropdown-divider my-1"></li>
                        <li>
                            <a class="dropdown-item d-flex gap-2 align-items-start py-2 rounded" asp-controller="Dashboard" asp-action="Index">
                                <i class="bi bi-exclamation-triangle-fill text-warning mt-1"></i>
                                <div>
                                    <div class="fw-semibold">12 Bench Resources > 30 Days</div>
                                    <small class="text-muted">Review available consultants for upcoming pipeline</small>
                                </div>
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item d-flex gap-2 align-items-start py-2 rounded" asp-controller="Skills" asp-action="Certifications">
                                <i class="bi bi-patch-check-fill text-primary mt-1"></i>
                                <div>
                                    <div class="fw-semibold">8 Certifications Expiring Soon</div>
                                    <small class="text-muted">AZ-305 & AI-102 renewal windows open</small>
                                </div>
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item d-flex gap-2 align-items-start py-2 rounded" asp-controller="Timesheets" asp-action="Index">
                                <i class="bi bi-clock-history text-danger mt-1"></i>
                                <div>
                                    <div class="fw-semibold">6 Timesheets Pending Approval</div>
                                    <small class="text-muted">Review current sprint timesheets</small>
                                </div>
                            </a>
                        </li>
                    </ul>
                </div>

                <!-- User Profile -->
                <div class="dropdown">
                    <a href="#" class="user-profile-btn dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                        <div class="user-avatar">SN</div>
                        <div class="d-none d-xl-block text-start" style="line-height: 1.2;">
                            <div class="fw-semibold" style="font-size: 13px;">Ravi Gunda</div>
                            <small class="text-muted" style="font-size: 11px;">Practice Director</small>
                        </div>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 p-2" style="font-size: 13px;">
                        <li class="px-2 py-1">
                            <div class="fw-bold">Ravi Gunda</div>
                            <div class="text-muted" style="font-size: 11px;">Ravi.Gunda@microsoftpractice.com</div>
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle mt-1">Practice Leadership</span>
                        </li>
                        <li><hr class="dropdown-divider my-2"></li>
                        <li><a class="dropdown-item" asp-controller="Reports" asp-action="Index"><i class="bi bi-download me-2"></i>Export Center</a></li>
                        <li><a class="dropdown-item" asp-controller="PracticeHealth" asp-action="Index"><i class="bi bi-activity me-2"></i>Health Analytics</a></li>
                        <li><hr class="dropdown-divider my-2"></li>
                        <li><a class="dropdown-item text-muted" href="#"><i class="bi bi-gear me-2"></i>Storage Status: Active</a></li>
                    </ul>
                </div>
            </div>
        </header>

        <!-- Body Layout -->
        <div class="main-layout">
            <!-- Left Sidebar Navigation -->
            <aside class="left-sidebar">
                <ul class="sidebar-nav">
                    <li class="nav-section-title">Core Modules</li>
                    <li class="sidebar-nav-item">
                        <a class="sidebar-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")" asp-controller="Dashboard" asp-action="Index">
                            <i class="bi bi-grid-1x2-fill"></i>
                            <span>Dashboard</span>
                        </a>
                    </li>
                    <li class="sidebar-nav-item">
                        <a class="sidebar-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Resources" ? "active" : "")" asp-controller="Resources" asp-action="Index">
                            <i class="bi bi-people-fill"></i>
                            <span>Resources</span>
                            <span class="nav-badge">@resourceCount</span>
                        </a>
                    </li>
                    <li class="sidebar-nav-item">
                        <a class="sidebar-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Projects" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")" asp-controller="Projects" asp-action="Index">
                            <i class="bi bi-kanban-fill"></i>
                            <span>Projects</span>
                            <span class="nav-badge">@projectCount</span>
                        </a>
                    </li>
                    @* <li class="sidebar-nav-item">
                        <a class="sidebar-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Projects" && ViewContext.RouteData.Values["action"]?.ToString() == "Timeline" ? "active" : "")" asp-controller="Projects" asp-action="Timeline">
                            <i class="bi bi-bar-chart-steps"></i>
                            <span>Allocation Timeline</span>
                        </a>
                    </li>
                    <li class="sidebar-nav-item">
                        <a class="sidebar-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "PracticeHealth" ? "active" : "")" asp-controller="PracticeHealth" asp-action="Index">
                            <i class="bi bi-heart-pulse-fill"></i>
                            <span>Practice Health</span>
                            <span class="nav-badge" style="background-color: var(--ms-green-light); color: var(--ms-green);">87%</span>
                        </a>
                    </li> *@

                @*     <li class="nav-section-title">Operations & Delivery</li>
                    <li class="sidebar-nav-item">
                        <a class="sidebar-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Timesheets" ? "active" : "")" asp-controller="Timesheets" asp-action="Index">
                            <i class="bi bi-clock-history"></i>
                            <span>Timesheets</span>
                        </a>
                    </li>
                    <li class="sidebar-nav-item">
                        <a class="sidebar-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Leave" ? "active" : "")" asp-controller="Leave" asp-action="Index">
                            <i class="bi bi-calendar-event-fill"></i>
                            <span>Leave Tracker</span>
                        </a>
                    </li>
                    <li class="sidebar-nav-item">
                        <a class="sidebar-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Appraisals" ? "active" : "")" asp-controller="Appraisals" asp-action="Index">
                            <i class="bi bi-award-fill"></i>
                            <span>Appraisals</span>
                        </a>
                    </li>

                    <li class="nav-section-title">Growth & IP</li>
                    <li class="sidebar-nav-item">
                        <a class="sidebar-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Skills" ? "active" : "")" asp-controller="Skills" asp-action="Index">
                            <i class="bi bi-mortarboard-fill"></i>
                            <span>Skills & Matrix</span>
                        </a>
                    </li>
                    <li class="sidebar-nav-item">
                        <a class="sidebar-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Innovation" ? "active" : "")" asp-controller="Innovation" asp-action="Index">
                            <i class="bi bi-lightbulb-fill"></i>
                            <span>Case Studies & IP</span>
                        </a>
                    </li>
                    <li class="sidebar-nav-item">
                        <a class="sidebar-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" ? "active" : "")" asp-controller="Reports" asp-action="Index">
                            <i class="bi bi-file-earmark-spreadsheet-fill"></i>
                            <span>Reports & Exports</span>
                        </a>
                    </li>
                </ul> *@

                <div class="mt-auto p-3 border-top bg-light" style="font-size: 11px; color: var(--ms-gray-130);">
                    <div class="d-flex align-items-center gap-1 mb-1">
                        <i class="bi bi-database-check text-success"></i>
                        <span class="fw-semibold">Azure Storage Backend</span>
                    </div>
                    <div>Tables: Azure.Data.Tables</div>
                    <div>Blobs: Azure.Storage.Blobs</div>
                </div>
            </aside>

            <!-- Main Content Canvas -->
            <main class="content-canvas" role="main">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm" role="alert">
                        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm" role="alert">
                        <i class="bi bi-exclamation-octagon-fill me-2"></i>@TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @RenderBody()
            </main>
        </div>
    </div>

    <!-- Reusable Quick View Modal Container -->
    <div class="modal fade" id="quickViewModal" tabindex="-1" aria-labelledby="quickViewModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header border-bottom px-4 py-3 bg-light">
                    <h5 class="modal-title fs-6 fw-semibold text-dark" id="quickViewModalLabel">
                        <i class="bi bi-person-badge me-2 text-primary"></i>Consultant Quick View
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4" id="quickViewModalBody">
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary" role="status"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Reusable Toast Notification Container -->
    <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1100;">
        <div id="hubGlobalToast" class="toast align-items-center text-bg-dark border-0" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body">Notification</div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    </div>

    <!-- Bootstrap 5 Bundle JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Chart.js 4.4.0 -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <!-- Site Scripts -->
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
