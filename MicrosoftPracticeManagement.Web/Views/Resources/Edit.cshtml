@model MicrosoftPracticeManagement.Services.DTOs.ResourceDto
@{
    ViewData["Title"] = $"Edit {Model.Name}";
}

<div class="page-header-bar">
    <div>
        <h1 class="page-title">Edit Consultant Profile</h1>
        <div class="page-desc">Update details for @Model.Name (@Model.EmployeeId)</div>
    </div>
    <a asp-action="Details" asp-route-id="@Model.EmployeeId" class="btn-fluent-secondary">
        <i class="bi bi-arrow-left"></i>Back to Profile
    </a>
</div>

<div class="fluent-card" style="max-width: 800px;">
    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="EmployeeId" />
        <input type="hidden" asp-for="ManagerId" />
        <input type="hidden" asp-for="ProfileImageUrl" />

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Name" class="form-label fw-semibold">Full Name *</label>
                <input asp-for="Name" class="form-control" required />
            </div>

            <div class="col-md-6">
                <label asp-for="Email" class="form-label fw-semibold">Email Address *</label>
                <input asp-for="Email" type="email" class="form-control" required />
            </div>

            <div class="col-md-6">
                <label asp-for="Designation" class="form-label fw-semibold">Designation *</label>
                <input asp-for="Designation" class="form-control" required />
            </div>

            <div class="col-md-6">
                <label asp-for="PrimarySkill" class="form-label fw-semibold">Primary Skill *</label>
                <input asp-for="PrimarySkill" class="form-control" required />
            </div>

            <div class="col-md-6">
                <label asp-for="SecondarySkill" class="form-label fw-semibold">Secondary Skill</label>
                <input asp-for="SecondarySkill" class="form-control" />
            </div>

            <div class="col-md-6">
                <label asp-for="ExperienceYears" class="form-label fw-semibold">Years of Experience</label>
                <input asp-for="ExperienceYears" type="number" step="0.5" class="form-control" />
            </div>

            <div class="col-md-6">
                <label asp-for="Location" class="form-label fw-semibold">Base Location</label>
                <input asp-for="Location" class="form-control" />
            </div>

            <div class="col-md-6">
                <label asp-for="ManagerName" class="form-label fw-semibold">Reporting Manager</label>
                <input asp-for="ManagerName" class="form-control" />
            </div>

            <div class="col-md-6">
                <label asp-for="AllocationPercent" class="form-label fw-semibold">Allocation %</label>
                <input asp-for="AllocationPercent" type="number" class="form-control" />
            </div>

            <div class="col-md-6">
                <label asp-for="Availability" class="form-label fw-semibold">Availability</label>
                <select asp-for="Availability" class="form-select">
                    <option value="Available">Available (Bench)</option>
                    <option value="Partially Allocated">Partially Allocated</option>
                    <option value="Allocated">Fully Allocated (100%)</option>
                    <option value="On Leave">On Leave</option>
                </select>
            </div>

            <div class="col-md-6">
                <label asp-for="Status" class="form-label fw-semibold">Status</label>
                <select asp-for="Status" class="form-select">
                    <option value="Active">Active</option>
                    <option value="Notice Period">Notice Period</option>
                    <option value="Sabbatical">Sabbatical</option>
                </select>
            </div>

            <div class="col-md-6 d-flex align-items-center mt-4">
                <div class="form-check form-switch">
                    <input asp-for="Billable" class="form-check-input" type="checkbox" />
                    <label asp-for="Billable" class="form-check-label fw-semibold">Billable Resource</label>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
            <a asp-action="Details" asp-route-id="@Model.EmployeeId" class="btn btn-outline-secondary">Cancel</a>
            <button type="submit" class="btn-fluent-primary">
                <i class="bi bi-check-lg"></i>Save Changes
            </button>
        </div>
    </form>
</div>
