@model MicrosoftPracticeManagement.Web.ViewModels.ResourceDetailsViewModel
@{
    ViewData["Title"] = $"{Model.Resource.Name} - Profile";
}

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb" style="font-size: 13px;">
        <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Resources</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.Resource.Name</li>
    </ol>
</nav>

<!-- Profile Header Banner Card -->
<div class="fluent-card mb-4">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div class="d-flex align-items-center gap-3">
            <img src="@Model.Resource.ProfileImageUrl" alt="@Model.Resource.Name" class="rounded-circle shadow-sm" width="72" height="72" />
            <div>
                <div class="d-flex align-items-center gap-2">
                    <h1 class="page-title fs-4 mb-0">@Model.Resource.Name</h1>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle">@Model.Resource.EmployeeId</span>
                    @if (Model.Resource.AllocationPercent == 0 || Model.Resource.Availability == "Available")
                    {
                        <span class="ms-badge badge-attention">Bench (@Model.Resource.BenchDays days)</span>
                    }
                    else
                    {
                        <span class="ms-badge badge-healthy">@Model.Resource.AllocationPercent% Allocated</span>
                    }
                </div>
                <div class="text-muted mt-1" style="font-size: 13px;">
                    <span class="fw-medium text-dark">@Model.Resource.Designation</span> • 
                    <span>@Model.Resource.Department</span> • 
                    <i class="bi bi-geo-alt me-1"></i>@Model.Resource.Location
                </div>
                <div class="mt-1" style="font-size: 12px;">
                    <a href="mailto:@Model.Resource.Email" class="text-decoration-none text-muted me-3">
                        <i class="bi bi-envelope me-1"></i>@Model.Resource.Email
                    </a>
                    <span class="text-muted">
                        <i class="bi bi-person-badge me-1"></i>Manager: <strong>@Model.Resource.ManagerName</strong> (@Model.Resource.ManagerId)
                    </span>
                </div>
            </div>
        </div>

        <div class="d-flex gap-2">
            <a asp-action="DownloadResume" asp-route-id="@Model.Resource.EmployeeId" class="btn-fluent-primary">
                <i class="bi bi-file-earmark-arrow-down"></i>Download Resume
            </a>
            <a asp-action="Edit" asp-route-id="@Model.Resource.EmployeeId" class="btn-fluent-secondary">
                <i class="bi bi-pencil"></i>Edit Profile
            </a>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Left Column: Core Experience & Skills Matrix -->
    <div class="col-lg-7">
        <!-- 1. Skills Matrix Card -->
        <div class="fluent-card mb-4">
            <div class="fluent-card-header">
                <h2 class="fluent-card-title"><i class="bi bi-tools text-primary"></i>Technical Competencies & Skills</h2>
                <span class="badge bg-light text-secondary border">@Model.Resource.Skills.Count Verified</span>
            </div>

            <div class="row g-3">
                @if (!Model.Resource.Skills.Any())
                {
                    <div class="col-12 text-muted py-3">No skills recorded yet for this consultant.</div>
                }
                else
                {
                    @foreach (var s in Model.Resource.Skills)
                    {
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded border">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="fw-semibold text-dark">@s.SkillName</span>
                                    <span class="ms-badge @(s.Level == "Expert" ? "badge-healthy" : s.Level == "Advanced" ? "badge-info" : "badge-neutral")">
                                        @s.Level
                                    </span>
                                </div>
                                <div class="d-flex justify-content-between text-muted" style="font-size: 11px;">
                                    <span>Category: @s.Category</span>
                                    <span>@s.YearsOfExperience yrs exp</span>
                                </div>
                                @if (!string.IsNullOrEmpty(s.Certification))
                                {
                                    <div class="mt-2 pt-2 border-top d-flex align-items-center justify-content-between" style="font-size: 11px;">
                                        <span class="text-primary fw-medium"><i class="bi bi-patch-check-fill me-1"></i>@s.Certification.Split(':')[0]</span>
                                        @if (s.IsExpiringSoon)
                                        {
                                            <span class="badge bg-warning text-dark">Expiring Soon</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Valid</span>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

        <!-- 2. Project Allocations History -->
        <div class="fluent-card">
            <div class="fluent-card-header">
                <h2 class="fluent-card-title"><i class="bi bi-kanban text-success"></i>Project Allocations & Delivery History</h2>
                <span class="badge bg-light text-secondary border">@Model.Resource.CurrentAllocations.Count Engagements</span>
            </div>

            @if (!Model.Resource.CurrentAllocations.Any())
            {
                <div class="p-4 text-center text-muted">
                    <i class="bi bi-calendar-x fs-3 text-secondary d-block mb-2"></i>
                    No active project allocations found. Consultant is currently on Bench.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" style="font-size: 13px;">
                        <thead class="table-light">
                            <tr>
                                <th>Project & Account</th>
                                <th>Role</th>
                                <th>Allocation</th>
                                <th>Timeline</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var a in Model.Resource.CurrentAllocations)
                            {
                                <tr>
                                    <td>
                                        <a asp-controller="Projects" asp-action="Details" asp-route-account="@a.Account" asp-route-id="@a.ProjectId" class="fw-semibold text-primary text-decoration-none">
                                            @a.ProjectName
                                        </a>
                                        <div class="text-muted" style="font-size: 11px;">@a.Account • @a.ProjectId</div>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">@a.Role</span>
                                    </td>
                                    <td>
                                        <span class="fw-bold text-success">@a.AllocationPercent%</span>
                                    </td>
                                    <td>
                                        <small class="text-muted">@a.StartDate.ToString("MMM yyyy") - @a.EndDate.ToString("MMM yyyy")</small>
                                    </td>
                                    <td>
                                        <span class="badge bg-success-subtle text-success">Active</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- Right Column: Meta Details, Certifications, Storage Info -->
    <div class="col-lg-5">
        <!-- Profile Summary Card -->
        <div class="fluent-card mb-4">
            <div class="fluent-card-header">
                <h3 class="fluent-card-title"><i class="bi bi-info-circle text-primary"></i>Consultant Information</h3>
            </div>
            <ul class="list-group list-group-flush" style="font-size: 13px;">
                <li class="list-group-item d-flex justify-content-between px-0 py-2">
                    <span class="text-muted">Total Industry Experience</span>
                    <span class="fw-bold">@Model.Resource.ExperienceYears Years</span>
                </li>
                <li class="list-group-item d-flex justify-content-between px-0 py-2">
                    <span class="text-muted">Primary Competency</span>
                    <span class="badge bg-primary">@Model.Resource.PrimarySkill</span>
                </li>
                <li class="list-group-item d-flex justify-content-between px-0 py-2">
                    <span class="text-muted">Secondary Skill</span>
                    <span class="badge bg-secondary">@Model.Resource.SecondarySkill</span>
                </li>
                <li class="list-group-item d-flex justify-content-between px-0 py-2">
                    <span class="text-muted">Billability Status</span>
                    <span class="fw-semibold @(Model.Resource.Billable ? "text-success" : "text-secondary")">
                        @(Model.Resource.Billable ? "Billable (Customer Facing)" : "Non-Billable / Internal")
                    </span>
                </li>
                <li class="list-group-item d-flex justify-content-between px-0 py-2">
                    <span class="text-muted">Base Location</span>
                    <span>@Model.Resource.Location Delivery Center</span>
                </li>
                <li class="list-group-item d-flex justify-content-between px-0 py-2">
                    <span class="text-muted">Employment Status</span>
                    <span class="ms-badge @(Model.Resource.Status == "Active" ? "badge-healthy" : "badge-attention")">
                        @Model.Resource.Status
                    </span>
                </li>
                <li class="list-group-item d-flex justify-content-between px-0 py-2">
                    <span class="text-muted">Join Date</span>
                    <span>@(Model.Resource.HireDate?.ToString("MMMM dd, yyyy") ?? "N/A")</span>
                </li>
            </ul>
        </div>

        <!-- Microsoft Credentials Card -->
        <div class="fluent-card">
            <div class="fluent-card-header">
                <h3 class="fluent-card-title"><i class="bi bi-patch-check-fill text-primary"></i>Microsoft Certifications</h3>
                <span class="badge bg-light text-secondary border">Verified Credentials</span>
            </div>

            @{
                var certSkills = Model.Resource.Skills.Where(s => !string.IsNullOrEmpty(s.Certification)).ToList();
            }

            @if (!certSkills.Any())
            {
                <div class="p-3 text-muted" style="font-size: 13px;">
                    No Microsoft certifications currently recorded for this resource.
                </div>
            }
            else
            {
                <div class="d-flex flex-column gap-2">
                    @foreach (var c in certSkills)
                    {
                        <div class="p-3 bg-light rounded border">
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <i class="bi bi-shield-fill-check text-primary fs-5"></i>
                                <div>
                                    <div class="fw-semibold text-dark" style="font-size: 13px;">@c.Certification</div>
                                    <small class="text-muted">Verified: @(c.VerifiedDate?.ToString("MMM yyyy") ?? "Practice Council")</small>
                                </div>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top" style="font-size: 11px;">
                                <span class="text-muted">Expiry: @(c.ExpiryDate?.ToString("MMM dd, yyyy") ?? "Active")</span>
                                @if (c.IsExpiringSoon)
                                {
                                    <span class="badge bg-warning text-dark">Renewal Due (60d)</span>
                                }
                                else
                                {
                                    <span class="badge bg-success-subtle text-success">Active Standing</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
